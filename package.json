    "art": "node scripts/cut-art.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
